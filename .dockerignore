# 环境变量与密钥（绝不进镜像）
.env

# 虚拟环境
.venv/
venv/

# Python 产物
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# 版本控制与仓库元数据
.git/
.gitignore
.gitattributes

# 运行时生成的向量库（容器内重新构建，用卷持久化）
chroma_db/
chroma_db_bge/
chroma_db_onlyup/
chroma_db_onlyup_bge/
*.sqlite3

# 体积大且非运行必需
docs/*.json
docs/*.png

# 测试
tests/

# 注意：README.md / PITFALLS.md / docs/*.md / deploy/README.md 要打进镜像，
# 因为它们会被当作知识库语料（让 demo 能回答"这个项目怎么做的"）。
# 其余非运行必需项排除。
LICENSE
docker-compose.yml
Dockerfile
.dockerignore

# 部署目录里的密钥（构建上下文里也不要有）
deploy/.env
deploy/.env.prod.example
